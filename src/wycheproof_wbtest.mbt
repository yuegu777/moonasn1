///|
test "wycheproof dsa_2048_256_sha256: SubjectPublicKeyInfo decode + classify" {
  let keys : Array[String] = [
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
  ]
  for i, hex in keys {
    let der = wp_hex_to_bytes(hex)
    match decode_element(der) {
      Ok(v) =>
        match classify_pubkey(v) {
          Other(oid="1.2.840.10040.4.1") => ()
          other => fail("wycheproof dsa_2048_256_sha256 SPKI #" + i.to_string() + ": wrong algorithm " + other.to_display())
        }
      Err(_) => fail("wycheproof dsa_2048_256_sha256 SPKI #" + i.to_string() + ": decode failed")
    }
  }
}

