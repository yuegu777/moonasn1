    "3076301006072a8648ce3d020106052b81040022036200040a2fc2edd21336babc59da04aa566dc9b6b068162f7970e311136883b61be8f894da03cc8e93a64803d4f4f83a19c1b973076220bf4d40aa9a41cacbafbd32d1f0bd183c327153cd6601bfa81d5e2ec21c0ecc517e004dd3fbedeca7f975a9ed",
  ]
  for i, hex in keys {
    let der = wp_hex_to_bytes(hex)
    match decode_element(der) {
      Ok(v) =>
        match classify_pubkey(v) {
          Ec(curve=Some("P-384")) => ()
          other => fail("wycheproof ecdsa_secp384r1_sha384 SPKI #" + i.to_string() + ": wrong algorithm " + other.to_display())
        }
      Err(_) => fail("wycheproof ecdsa_secp384r1_sha384 SPKI #" + i.to_string() + ": decode failed")
    }
  }
}

